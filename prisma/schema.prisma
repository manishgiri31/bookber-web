generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PAID
  DUE
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WaitlistRole {
  customer
  barber
}

enum QueueSource {
  walk_in
  remote
}

enum QueueStatus {
  waiting
  called
  in_service
  done
  slipped
  cancelled
  no_show
}

enum MessageCategory {
  utility
  marketing
}

enum WalletTxnType {
  topup
  message_utility
  message_marketing
  adjustment
}

enum QueueEventType {
  NEXT_PRESSED
  CUSTOMER_ARRIVED
  SERVICE_ADDED
  COMPLETED
  SLIPPED
}

enum EventAppliedStatus {
  applied
  partially_applied
  rejected
  duplicate
}

model Shop {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  city               String
  address            String
  phone              String
  ownerName          String
  chairs             Int
  timezone           String             @default("Asia/Kolkata")
  // Hour (0-23, in shop's local timezone) at which the business day rolls
  // over. Shops close after midnight, so a token sold at 12:30am still
  // belongs to the *previous* business_date until this hour passes.
  dayStartHour       Int                @default(6)
  isActive           Boolean            @default(true)
  qrSecret           String             @unique @default(cuid())
  // Shop-wide 4-digit PIN (hashed) that unlocks the barber console on a
  // device. Not per-barber — the console has a separate "who is
  // operating" barber selector once unlocked.
  pinHash            String?
  // Rate limiting on PIN login — a 4-digit PIN is only 10,000 combinations.
  pinFailedAttempts  Int                @default(0)
  pinLockedUntil     DateTime?
  // Cached, denormalized for fast reads. Source of truth is the sum of
  // WalletTransaction.amountPaise for this shop.
  walletBalancePaise Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())

  barbers            Barber[]
  services           Service[]
  queueEntries       QueueEntry[]
  subscriptions      Subscription[]
  walletTransactions WalletTransaction[]
  messageLogs        MessageLog[]
  udhaarLedgers      UdhaarLedger[]
  barberSessions     BarberSession[]
  queueEventLogs     QueueEventLog[]

  @@index([verificationStatus])
  @@index([city])
}

model Barber {
  id            String   @id @default(cuid())
  name          String
  shopId        String
  isActive      Boolean  @default(true)
  commissionPct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())

  shop                    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  preferredByQueueEntries QueueEntry[]    @relation("BarberPreference")
  assignedQueueEntries    QueueEntry[]    @relation("AssignedBarber")
  queueEventLogs          QueueEventLog[]

  @@index([shopId])
}

model Service {
  id                 String   @id @default(cuid())
  shopId             String
  name               String
  pricePaise         Int
  defaultDurationMin Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  queueEntryServices QueueEntryService[]

  @@index([shopId])
}

// The central table. This is a token, not a booking.
model QueueEntry {
  id               String      @id @default(cuid())
  shopId           String
  // The shop's "day", derived from dayStartHour at creation time — not the
  // calendar date. token_number resets per (shop, business_date).
  businessDate     DateTime    @db.Date
  tokenNumber      Int
  customerPhone    String
  customerName     String?
  source           QueueSource
  barberPrefId     String?
  assignedBarberId String?
  status           QueueStatus @default(waiting)
  slipCount        Int         @default(0)
  joinedAt         DateTime    @default(now())
  arrivedAt        DateTime?
  calledAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  // Recorded at completion, never at join. Cached sum of
  // QueueEntryService.pricePaiseAtCompletion for quick reads.
  amountPaise      Int?
  // Random URL-safe string. This IS the customer's session — no login.
  publicToken      String      @unique @default(cuid())

  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barberPref     Barber?             @relation("BarberPreference", fields: [barberPrefId], references: [id])
  assignedBarber Barber?             @relation("AssignedBarber", fields: [assignedBarberId], references: [id])
  services       QueueEntryService[]
  messageLogs    MessageLog[]
  eventLogs      QueueEventLog[]

  @@unique([shopId, businessDate, tokenNumber])
  @@index([shopId, status])
  @@index([shopId, businessDate])
  @@index([customerPhone])
  @@index([publicToken])
}

// Services are added mid-visit, so this is its own table rather than a
// fixed set chosen at join time.
model QueueEntryService {
  id                     String @id @default(cuid())
  queueEntryId           String
  serviceId              String
  pricePaiseAtCompletion Int

  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id])

  @@index([queueEntryId])
  @@index([serviceId])
}

model MessageLog {
  id           String          @id @default(cuid())
  shopId       String
  queueEntryId String?
  category     MessageCategory
  costPaise    Int
  sentAt       DateTime        @default(now())

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  queueEntry QueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([category])
}

// Append-only. Shop.walletBalancePaise is a cached read of this, not the
// source of truth.
model WalletTransaction {
  id           String        @id @default(cuid())
  shopId       String
  type         WalletTxnType
  // Signed: positive = credit (topup), negative = debit (message cost).
  amountPaise  Int
  balanceAfter Int
  refId        String?
  createdAt    DateTime      @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

// Per shop, per customer phone, running balance. Replaces the paper
// udhaar notebook.
model UdhaarLedger {
  id            String   @id @default(cuid())
  shopId        String
  customerPhone String
  balancePaise  Int      @default(0)
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, customerPhone])
}

// A device unlocked for a shop's console via the shop-wide PIN. "Who is
// operating" (which barber) is tracked client-side, not here — this row
// is purely the device-level auth/revocation boundary.
model BarberSession {
  id         String    @id @default(cuid())
  shopId     String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  queueEventLogs QueueEventLog[]

  @@index([shopId])
}

// Append-only. Every barber console action is logged here first (offline,
// with a client-generated clientEventId for idempotency) and replayed
// against QueueEntry state on sync.
model QueueEventLog {
  id              String              @id @default(cuid())
  clientEventId   String              @unique
  shopId          String
  barberSessionId String?
  barberId        String
  queueEntryId    String
  type            QueueEventType
  payload         Json
  // When the action actually happened on-device — drives ordering.
  clientCreatedAt DateTime
  // When the server received it during sync — for sync-lag visibility only.
  receivedAt      DateTime            @default(now())
  appliedStatus   EventAppliedStatus?
  rejectReason    String?

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barberSession BarberSession? @relation(fields: [barberSessionId], references: [id], onDelete: SetNull)
  barber        Barber         @relation(fields: [barberId], references: [id])
  queueEntry    QueueEntry     @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([shopId, clientCreatedAt])
  @@index([queueEntryId])
}

// B2B billing only: shop pays us. Never touches customer-to-shop money.
model Subscription {
  id          String             @id @default(cuid())
  shopId      String
  status      SubscriptionStatus @default(ACTIVE)
  mrrPaise    Int                @default(59900)
  trialEndsAt DateTime?
  startedAt   DateTime           @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([shopId])
  @@index([status])
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  amountPaise    Int
  status         InvoiceStatus @default(DUE)
  issuedAt       DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  disputes     Dispute[]

  @@index([subscriptionId])
  @@index([status])
}

model Dispute {
  id        String        @id @default(cuid())
  invoiceId String
  reason    String
  status    DisputeStatus @default(OPEN)
  openedAt  DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status])
}

model SupportTicket {
  id        String         @id @default(cuid())
  subject   String
  category  String
  priority  TicketPriority @default(MEDIUM)
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now())

  @@index([status])
  @@index([priority])
}

model WaitlistEntry {
  id        String       @id @default(cuid())
  email     String       @unique
  city      String
  role      WaitlistRole
  name      String?
  createdAt DateTime     @default(now())

  @@index([city])
  @@index([role])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  target     String
  at         DateTime @default(now())

  @@index([actorEmail])
  @@index([at])
}
